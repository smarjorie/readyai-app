{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png|icon-192.png|icon-512.png|icon-maskable-512.png|og-image.png|og-agencias.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "convite"
        }
      ],
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "redefinir"
        }
      ],
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/agencias/",
      "destination": "/agencias",
      "permanent": true
    },
    {
      "source": "/calculadora-roas/",
      "destination": "/calculadora-roas",
      "permanent": true
    },
    {
      "source": "/calculadora-cpa/",
      "destination": "/calculadora-cpa",
      "permanent": true
    },
    {
      "source": "/calculadora-roi/",
      "destination": "/calculadora-roi",
      "permanent": true
    },
    {
      "source": "/calculadoras/",
      "destination": "/calculadoras",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/agencias",
      "destination": "/agencias/index.html"
    },
    {
      "source": "/calculadora-roas",
      "destination": "/calculadora-roas/index.html"
    },
    {
      "source": "/calculadora-cpa",
      "destination": "/calculadora-cpa/index.html"
    },
    {
      "source": "/calculadora-roi",
      "destination": "/calculadora-roi/index.html"
    },
    {
      "source": "/calculadoras",
      "destination": "/calculadoras/index.html"
    }
  ]
}
